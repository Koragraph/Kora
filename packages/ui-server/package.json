  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@kora/contracts": "workspace:*",
    "@kora/shared": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  }
}
