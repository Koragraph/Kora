// The React client: bundled by Vite, so bundler resolution and JSX; `~/` is src/.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": false,
    "paths": { "~/*": ["./src/*"] },
    "plugins": [
      {
        "name": "@effect/language-service",
        // Browser code may use the platform globals directly (merged over the base severities).
        "diagnosticSeverity": {
          "globalConsole": "off",
          "globalDate": "off",
          "globalFetch": "off",
          "globalRandom": "off",
          "globalTimers": "off"
        }
      }
    ]
  },
  "include": [
    "src",
    "test",
    "vite",
    "vite.config.ts",
    "scripts/warm-dep-cache.ts",
    "../../scripts/lib/repo-env.ts"
  ]
}
