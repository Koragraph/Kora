{
  "name": "@kora/runtime",
  "version": "0.1.14",
  "description": "The kora runtime: the daemon (chat sessions, orchestrator worker panes, worktrees, merge gate), the code-graph token-savings layer and the kora CLI.",
  "bin": {
    "kora": "bin/kora.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "dist/",
    "koragraph/",
    "ui/",
    "manifests/",
    "scripts/",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --require ./scripts/test-isolate.cjs --test --test-force-exit --test-concurrency=4 --test-timeout=300000 \"dist/**/*.test.js\"",
    "canary": "node scripts/e2e-inject-canary.js",
    "bench:paired": "tsc -p tsconfig.json && node dist/bench/paired/cli.js",
    "bench:gate": "node bin/kora.js bench --gate --summary ${BENCH_SUMMARY:-bench-out/summary.json}"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "better-sqlite3": "^13.0.3",
    "docx": "9.5.1",
    "dotenv": "^18.0.8",
    "exceljs": "4.4.0",
    "joi": "^18.1.2",
    "js-yaml": "^5.2.1",
    "jszip": "3.10.1",
    "node-pty": "^1.1.0",
    "node-sql-parser": "^5.4.0",
    "pptxgenjs": "3.12.0",
    "smol-toml": "^1.8.0",
    "tree-sitter-wasms": "^0.1.13",
    "unpdf": "1.4.0",
    "web-tree-sitter": "^0.24.7",
    "web-tree-sitter-next": "npm:web-tree-sitter@^0.26.12",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "private": true,
  "license": "MIT"
}
