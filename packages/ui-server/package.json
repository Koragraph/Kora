{
  "name": "@kora/ui-server",
  "version": "0.1.0",
  "private": true,
  "description": "The UI protocol server (RPC over WebSocket); bundled into the daemon.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
